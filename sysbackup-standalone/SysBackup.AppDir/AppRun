#!/bin/bash
HERE="$(dirname "$(readlink -f "$0")")"
export PYTHONHOME="$HERE/usr"
export PYTHONPATH="$HERE/usr/lib/sysbackup:$HERE/usr/lib/python3.12:$HERE/usr/lib/python3.12/lib-dynload${PYTHONPATH:+:$PYTHONPATH}"
PY="$HERE/usr/bin/python3"
case "${1:-}" in
  --cli) shift; exec "$PY" "$HERE/usr/lib/sysbackup/sysbackup-cli" "$@" ;;
  backup|restore|disable-sudo-password|serve|remote-backup|remote-restore|remote-disable-sudo-password|check|-h|--help) exec "$PY" "$HERE/usr/lib/sysbackup/sysbackup-cli" "$@" ;;
esac
exec "$PY" "$HERE/usr/lib/sysbackup/sysbackup-gui" "$@"
