   "content_scripts": [
       {
          "css": [
             "css/youtube.css",
             "css/ma.css"
          ],
          "exclude_matches": [
             "*://www.youtube.com/embed/*"
          ],
          "js": [
             "js/youtube-main.js",
             "js/ma-main-world.js"
          ],
          "matches": [
             "*://www.youtube.com/*"
          ],
          "run_at": "document_start",
          "world": "MAIN"
       },
       {
          "exclude_matches": [
             "*://www.youtube.com/embed/*"
          ],
          "js": [
             "js/config.js",
             "js/youtube-isolated.js",
             "js/ma-content.js"
          ],
          "matches": [
             "*://www.youtube.com/*"
          ],
          "run_at": "document_start",
          "world": "ISOLATED"
       },
      {
         "all_frames": true,
         "js": [
            "js/embed-main.js"
         ],
         "matches": [
            "*://www.youtube.com/embed/*",
            "*://www.youtube-nocookie.com/embed/*"
         ],
         "run_at": "document_start",
         "world": "MAIN"
      },
      {
         "all_frames": true,
         "js": [
            "js/config.js",
            "js/embed-isolated.js"
         ],
         "matches": [
            "*://www.youtube.com/embed/*",
            "*://www.youtube-nocookie.com/embed/*"
         ],
         "run_at": "document_start",
         "world": "ISOLATED"
      },
      {
         "all_frames": true,
         "js": [
            "js/live-chat-main.js"
         ],
         "matches": [
            "*://www.youtube.com/live_chat*"
         ],
         "run_at": "document_start",
         "world": "MAIN"
      },
      {
         "all_frames": true,
         "js": [
            "js/config.js",
            "js/live-chat-isolated.js"
         ],
         "matches": [
            "*://www.youtube.com/live_chat*"
         ],
         "run_at": "document_start",
         "world": "ISOLATED"
      },
      {
         "css": [
            "css/pop-up-player.css"
         ],
         "js": [
            "js/pop-up-player-isolated.js"
         ],
         "matches": [
            "*://www.youtube-nocookie.com/pop-up-player/*"
         ],
         "run_at": "document_end",
         "world": "ISOLATED"
      },
      {
         "js": [
            "js/config.js",
            "js/shorts-isolated.js"
         ],
         "matches": [
            "*://www.youtube.com/shorts/*"
         ],
         "run_at": "document_start",
         "world": "ISOLATED"
      }
   ],
   "default_locale": "en_US",
   "description": "__MSG_description__",
   "host_permissions": [
      "*://www.youtube.com/*",
      "*://www.youtube-nocookie.com/*"
   ],
   "icons": {
      "128": "img/icons/128.png",
      "16": "img/icons/16.png",
      "19": "img/icons/19.png",
      "24": "img/icons/24.png",
      "32": "img/icons/32.png",
      "38": "img/icons/38.png",
      "48": "img/icons/48.png",
      "64": "img/icons/64.png",
      "96": "img/icons/96.png"
   },
   "key": "",
   "manifest_version": 3,
   "minimum_chrome_version": "128.0.0.0",
   "name": "Enhancer for YouTube™",
   "options_page": "html/options.html",
   "permissions": [
      "downloads",
      "storage"
   ],
   "version": "3.1.0",
   "web_accessible_resources": [
      {
         "matches": [
            "*://www.youtube.com/*",
            "*://www.youtube-nocookie.com/*"
         ],
         "resources": [
            "_locales/*/messages.json",
            "css/themes/*",
            "vendor/*"
         ]
      }
   ]
}
