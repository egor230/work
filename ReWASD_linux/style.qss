/* ReWASD Linux — визуальный стиль, повторяющий reWASD 9.3 */
QWidget#central { background:#161616; }
QFrame#topbar { background:#1C1C20; border-bottom:1px solid #2F2F2F; }
QLabel#appTitle { color:#F2F2F2; font-family:'Barlow','Segoe UI'; font-size:18px; font-weight:700; letter-spacing:1px; }
QLabel#appSub { color:#8E918F; font-family:'Barlow'; font-size:11px; }

/* Левая панель */
QFrame#sidebar { background:#1C1C20; border-right:1px solid #2F2F2F; }
QListWidget#nav { background:transparent; border:0; color:#999999; font-family:'Barlow'; font-size:14px; font-weight:600; }
QListWidget#nav::item { height:42px; padding-left:14px; border-radius:6px; }
QListWidget#nav::item:selected { background:#09518A; color:#FFFFFF; }
QListWidget#nav::item:hover { background:#2C2C31; }

QLabel#sideHeader { color:#F2F2F2; font-family:'Barlow'; font-size:12px; font-weight:700; letter-spacing:1px; }
QListWidget#profiles { background:#161616; border:1px solid #3D3D3D; border-radius:7px; color:#999999; font-family:'Barlow'; font-size:13px; }
QListWidget#profiles::item { height:34px; padding-left:10px; }
QListWidget#profiles::item:selected { background:#09518A; color:#FFFFFF; }

/* Контент */
QFrame#page { background:#2E2E33; border:1px solid #3D3D3D; border-radius:7px; }
QLabel#h1 { color:#FFFFFF; font-family:'Barlow'; font-size:22px; font-weight:800; letter-spacing:1px; }
QLabel#h2 { color:#F2F2F2; font-family:'Barlow'; font-size:15px; font-weight:700; }
QLabel#muted { color:#999999; font-family:'Barlow'; font-size:12px; }
QLabel#gold { color:#F8C000; font-family:'Barlow'; font-size:13px; font-weight:700; }

/* Кнопки */
QPushButton { font-family:'Barlow'; font-size:13px; font-weight:600; border-radius:4px; padding:8px 18px; }
QPushButton#primary { background:#F8C000; color:#141414; border:1px solid #F8C000; min-height:34px; }
QPushButton#primary:hover { background:#FFD21A; }
QPushButton#primary:pressed { background:#E0B000; }
QPushButton#secondary { background:#2C2C31; color:#F2F2F2; border:1px solid #3D3D3D; min-height:34px; }
QPushButton#secondary:hover { background:#36363d; border-color:#52525b; }
QPushButton#ghost { background:transparent; color:#999999; border:0; }
QPushButton#ghost:hover { color:#F8C000; }
QPushButton#danger { background:transparent; color:#CF4647; border:1px solid #CF4647; }

/* Поля */
QComboBox { background:#222226; color:#F2F2F2; border:1px solid #3D3D3D; border-radius:4px; padding:5px 8px; font-family:'Barlow'; min-height:26px; }
QComboBox::drop-down { subcontrol-origin:padding; subcontrol-position:top right; width:22px; border-left:1px solid #3D3D3D; }
QComboBox::down-arrow { image:url(assets/arrow_down.png); width:14px; height:14px; margin-right:5px; }
QComboBox QAbstractItemView { background:#222226; color:#F2F2F2; border:1px solid #3D3D3D; selection-background-color:#09518A; }
QLineEdit { background:#222226; color:#F2F2F2; border:1px solid #3D3D3D; border-radius:4px; padding:6px; font-family:'Barlow'; }
QCheckBox { color:#F2F2F2; font-family:'Barlow'; spacing:8px; }
QCheckBox::indicator { width:16px; height:16px; border:1px solid #3D3D3D; border-radius:3px; background:#222226; }
QCheckBox::indicator:checked { background:#F8C000; border-color:#F8C000; }

/* Радиокнопки «Удерживать / Повторять» — только одно положение */
QRadioButton { color:#F2F2F2; font-family:'Barlow'; spacing:8px; }
QRadioButton::indicator { width:16px; height:16px; border:1px solid #3D3D3D; border-radius:9px; background:#222226; }
QRadioButton::indicator:checked { background:#F8C000; border:2px solid #F8C000; border-radius:9px; }
QSlider::groove:horizontal { height:4px; background:#222226; border-radius:2px; }
QSlider::handle:horizontal { width:14px; height:14px; margin:-5px 0; border-radius:7px; background:#F8C000; }
QSlider::sub-page:horizontal { background:#F8C000; border-radius:2px; }

/* Таблицы и списки */
QTableWidget, QTreeWidget { background:#222226; color:#F2F2F2; border:1px solid #3D3D3D; gridline-color:#2F2F2F; font-family:'Barlow'; }
QHeaderView::section { background:#2C2C31; color:#999999; border:0; border-right:1px solid #3D3D3D; border-bottom:1px solid #3D3D3D; padding:6px; font-family:'Barlow'; }
/* видимая линия разделителя между панелью мыши и таблицей */
QSplitter::handle:vertical { height:5px; background:#3D3D3D; }
QSplitter::handle:vertical:hover { background:#F8C000; }
QTableWidget::item:selected { background:#09518A; }

/* Прогресс и статус */
QProgressBar { background:#1C1C20; border:1px solid #3D3D3D; border-radius:3px; height:6px; text-align:center; }
QProgressBar::chunk { background:qlineargradient(x1:0,y1:0,x2:1,y2:0,stop:0 #F8C000,stop:1 #9fd12a); }
QFrame#statusbar { background:#1C1C20; border-top:1px solid #2F2F2F; }
QLabel#status { color:#999999; font-family:'Barlow'; font-size:12px; }

/* Всплывающие */
QToolTip { background:#1C1C20; color:#F2F2F2; border:1px solid #3D3D3D; }
QScrollBar:vertical { background:#1C1C20; width:10px; }
QScrollBar::handle:vertical { background:#3D3D3D; border-radius:5px; }
QScrollBar::handle:vertical:hover { background:#52525b; }
